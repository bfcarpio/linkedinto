<% if summary_blocks %>
\cvsection{Summary}
<% for block in summary_blocks %>
<% if block.text %>
\begin{cvparagraph}
<< block.text >>
\end{cvparagraph}
<% endif %>
<% if block.highlights %>
\begin{cvitems}
<% for item in block.highlights %>
  \item {<< item >>}
<% endfor %>
\end{cvitems}
<% endif %>
<% endfor %>
<% endif %>