<% if projects %>
\cvsection{Projects}
\begin{cventries}
<% for proj in projects %>
  \cventry
    {}
    {<< latex_escape(proj.name) >>}
    {}
    {<< format_date_range(proj.started, proj.ended) >>}
    {
<% if proj.summary or proj.highlights %>
      \begin{cvitems}
<% if proj.summary %>
        \item {<< proj.summary >>}
<% endif %>
<% for item in proj.highlights %>
        \item {<< item >>}
<% endfor %>
      \end{cvitems}
<% endif %>
    }
<% endfor %>
\end{cventries}
<% endif %>
