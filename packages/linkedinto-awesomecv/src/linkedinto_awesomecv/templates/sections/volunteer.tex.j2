<% if volunteer %>
\cvsection{Volunteer Experience}
\begin{cventries}
<% for v in volunteer %>
  \cventry
    {<< latex_escape(v.position) >>}
    {<< latex_escape(v.organization) >>}
    {<< latex_escape(v.location) >>}
    {<< format_date_range(v.started, v.ended) >>}
    {
<% if v.summary or v.highlights %>
      \begin{cvitems}
<% if v.summary %>
        \item {<< v.summary >>}
<% endif %>
<% for item in v.highlights %>
        \item {<< item >>}
<% endfor %>
      \end{cvitems}
<% endif %>
    }
<% endfor %>
\end{cventries}
<% endif %>
